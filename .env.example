# This file (and skills/, .core-agent/hooks.json, .core-agent/cron.json) is
# read from the current directory first; if not found there, core-agent
# falls back to the same filename under ~/.core-agent (or CORE_AGENT_HOME,
# if set) — so a distributed binary placed on PATH still finds its config
# when launched from any directory. On first run, if neither location has a
# .env, one is generated at ~/.core-agent/.env from this template.
# CORE_AGENT_HOME=/path/to/alternate/global/config/dir

# Main text/coding model (speed is secondary to coding quality)
OPENAI_BASE_URL=http://127.0.0.1:8000/v1
OPENAI_API_KEY=
LLM_MODEL=deepseek-v4-flash
# Set to "anthropic" to speak /v1/messages instead of OpenAI's /v1/chat/completions.
LLM_PROTOCOL=openai

# Vision fallback model, used only via the view_image tool call.
# Most strong coding models (DeepSeek/GLM family) have no vision support,
# so a separate vision-capable model is routed to on demand.
VISION_BASE_URL=
VISION_API_KEY=
VISION_MODEL=

# Max tool-use rounds per turn before the agent is forced to stop and answer.
MAX_TOOL_ROUNDS=50

# Rough token-budget (chars/4 estimate) past which older history gets
# summarized so long sessions don't overflow the model's context window.
MAX_CONTEXT_TOKENS=60000

# If set, google_search hits this HTTP JSON endpoint (e.g. a self-hosted
# SearXNG instance) as "<url>/search?q=<query>&format=json" instead of
# driving a real Chrome against google.com — no browser/bot-detection
# involved on this path. Leave unset to keep the default browser-based search.
# SEARCH_ENGINE_URL=http://192.168.11.50:8888

# Browser (visit_page/google_search tools). All optional.
# CORE_AGENT_CHROME=/path/to/chrome              # explicit Chrome executable path
# CORE_AGENT_CHROME_PROFILE=/path/to/profile-dir # explicit profile dir (default ~/.core-agent/browser)
# CORE_AGENT_CHROME_HEADLESS=1                   # run headless instead of a visible window
# CORE_AGENT_CHROME_WINDOW_SIZE=480,360          # visible window size in pixels (default 480,360)
# CORE_AGENT_CHROME_WINDOW_POSITION=0,0          # visible window position in pixels (default top-left corner)

# Set to disable colorized/Markdown CLI output (also auto-disabled for non-TTY output).
# NO_COLOR=1

# Absolute path to a Python interpreter (typically inside a venv you manage
# yourself, with whatever libraries you want available — pandas/matplotlib/
# requests etc). If set, the agent is told to use this instead of a bare
# python/python3, so it doesn't pip-install into your system Python.
# PYTHON_PATH=/path/to/venv/bin/python

# mail_send skill (skills/mail_send): sends email via SMTP.
# EMAIL_TO is the default recipient when a tool call doesn't specify one
# (e.g. a cron job that always mails you). For Gmail, EMAIL_SMTP_PASSWORD
# must be a 2FA app password (Google Account > Security > App passwords),
# not your regular account password.
EMAIL_TO=
EMAIL_FROM=
EMAIL_SMTP_SERVER=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=
EMAIL_SMTP_PASSWORD=
